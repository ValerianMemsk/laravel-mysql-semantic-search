{
  "name": "valerianmemsk/laravel-semantic-search",
  "description": "Production-ready Semantic & Hybrid Search with Vector Embeddings for Laravel & MariaDB/MySQL",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Valerian Memsk",
      "homepage": "https://github.com/ValerianMemsk"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "suggest": {
    "laravel/scout": "Required to use SemanticSearchEngine as a Scout driver (^11.0|^12.0)."
  },
  "require-dev": {
    "laravel/scout": "^11.0|^12.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "ValerianMemsk\\SemanticSearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ValerianMemsk\\SemanticSearch\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ValerianMemsk\\SemanticSearch\\SemanticSearchServiceProvider"
      ],
      "aliases": {
        "SemanticSearch": "ValerianMemsk\\SemanticSearch\\Facades\\SemanticSearch"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
